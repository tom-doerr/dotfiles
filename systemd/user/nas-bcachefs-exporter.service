[Unit]
Description=NAS bcachefs /pool (reconcile backlog, replication, devices) -> Prometheus textfile
After=network-online.target

[Service]
Type=simple
Environment=NAS_BCACHEFS_INTERVAL=60
ExecStart=/home/tom/git/dotfiles/scripts/nas-bcachefs-exporter.py
Restart=always
RestartSec=30
Nice=15

[Install]
WantedBy=default.target
