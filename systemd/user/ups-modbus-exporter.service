[Unit]
Description=UPS Modbus -> Prometheus textfile exporter (PowerWalker VFI 3000)
After=network-online.target

[Service]
Type=simple
Environment=UPS_SAMPLE_HZ=20
Environment=UPS_WRITE_SEC=1
ExecStart=/home/tom/git/dotfiles/scripts/ups-modbus-exporter.py
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=default.target
