[Unit]
Description=High-rate thermal sample collector (UDP -> Postgres telemetry)
Documentation=https://github.com/tom-doerr/dotfiles
After=network-online.target postgresql.service

[Service]
Type=simple
Environment=THERMAL_PORT=5601
Environment=THERMAL_FLUSH_MS=200
# THERMAL_DSN lives outside the repo because it carries the NAS password.
# Falls back to the local spark-1 DB if the file is missing.
Environment=THERMAL_DSN=dbname=telemetry
EnvironmentFile=-%h/.config/thermal-collector/env
ExecStart=%h/git/dotfiles/scripts/thermal-collector.py
Restart=always
RestartSec=5
# Never let this be OOM-killed: it holds the only copy of samples from a
# spark that has already stopped responding.
OOMScoreAdjust=-500
MemoryMax=1G

[Install]
WantedBy=default.target
