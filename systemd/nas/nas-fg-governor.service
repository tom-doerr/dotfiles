# Deployed to nas:/etc/systemd/system/nas-fg-governor.service
# Source: ~/git/dotfiles/systemd/nas/ + scripts/nas-fg-governor
#
# Flips the pool's foreground_target between the ssd and hdd groups based on
# free+cached headroom of the SSD user-data devices (Lexars). Supplies the
# "foreground target is nearly full" logic bcachefs 1.39 lacks.
#
# Manual override: `touch /run/nas-fg-governor/hold` suspends actions
# (logged, nas_fg_governor_hold=1); remove the file to resume.
# Tunables via Environment= (NAS_FG_LOW_PCT / NAS_FG_HIGH_PCT / NAS_FG_DWELL ...).
[Unit]
Description=bcachefs foreground-target governor for /pool (ssd<->hdd on Lexar headroom)
Requires=pool-mount.service
After=pool-mount.service

[Service]
# Sep 6 2026: Lexars relabelled ssd.nand.* (Optane becomes ssd.optane.*); the
# healthy foreground target is the NAND subgroup, not the whole ssd group.
Environment=NAS_FG_SSD_GROUP=ssd.nand
# Sep 18 2026: 5/9 left lexar2 only 69 GB when writes moved to HDD; the btree
# kept growing ~20 GB/h per Lexar during a bulk ingest and hit the floor in 4 h
# (btree writes then spill to HDDs). 15/25 leaves ~215 GB on lexar2 = ~10 h.
Environment=NAS_FG_LOW_PCT=15
Environment=NAS_FG_HIGH_PCT=25
# Sep 18 2026: agent mode. nas-sysadmin (spark-1, DSPy) writes its decision into this
# file every 15 min; the governor applies it (dwell-limited) and keeps only the LOW floor
# as a veto. Stale request (> NAS_FG_AGENT_MAX_AGE, 45 min) = legacy watermarks, logged.
Environment=NAS_FG_AGENT_FILE=/home/tom/.local/state/nas-sysadmin/fg_target
Type=simple
ExecStart=/usr/local/sbin/nas-fg-governor
Restart=always
RestartSec=30
StateDirectory=nas-fg-governor
RuntimeDirectory=nas-fg-governor
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=pool-mount.service
