#!/bin/sh
# Reload the bcachefs kernel module on the NAS WITHOUT a reboot, e.g. after
# `dkms install` of a new build. Deployed to nas:~/switch-noreboot.sh
# (source: dotfiles scripts/nas-switch-noreboot). Run as root:
#
#   sudo sh ~/switch-noreboot.sh        # in the NAS base tmux, THEN
#   ssh root@ha 'ha host shutdown'      # from spark-1 (or the HA UI): clean guest shutdown
#
# The script waits for qemu to exit and stops haos-vm inside its 10 s RestartSec
# window (a plain `systemctl stop` would SIGTERM qemu = unclean guest). It then
# stops the databases with a long grace, stops docker, unmounts the pool (with
# retries: docker releases its /pool references asynchronously, so the first
# umount right after `systemctl stop docker` fails EBUSY - that aborted the
# Sep 20 2026 run), swaps the module, remounts (the keyring loses the pool key
# across rmmod -> the passphrase prompt appears on this tty), restarts docker,
# every compose stack (their oneshot units do NOT rerun on a pool-mount restart),
# the pool-options/governor/raiser units and the HA VM, and prints the result.
set -e
log(){ echo "$(date -u +%T) $*"; }
HOLDERS=/home/tom/nas-pool-holders
STACKS="nas-postgres nas-phoenix nas-mlflow nas-minio nas-prometheus nas-cadvisor immich ha-postgres"
UNITS="bcachefs-pool-options nas-fg-governor nas-replica-raiser haos-vm"

[ "$(id -u)" = 0 ] || { log "ABORT: run as root (sudo)"; exit 1; }
[ -x "$HOLDERS" ] || { log "ABORT: $HOLDERS missing (deploy dotfiles scripts/nas-pool-holders first)"; exit 1; }
pgrep -f qemu-system >/dev/null || { log "ABORT: qemu is not running - start the VM first or use the reboot path"; exit 1; }

log "waiting up to 10 min for the HA guest to shut down (trigger it now from spark-1)"
for i in $(seq 1 600); do pgrep -f qemu-system >/dev/null || break; sleep 1; done
pgrep -f qemu-system >/dev/null && { log "ABORT: guest still running after 10 min"; exit 1; }
systemctl stop haos-vm.service; log "haos-vm: $(systemctl is-active haos-vm.service) (auto-restart cancelled)"

log "docker stop DBs (grace 600 s)"
docker stop -t 600 nas-postgres ha_postgres_recorder immich_postgres mlflow-postgres 2>&1 | tr "\n" " "; echo
log "stopping docker"; systemctl stop docker docker.socket; log "docker: $(systemctl is-active docker)"

log "stopping pool-mount (blocking umount, retried up to 5 min)"
systemctl stop pool-mount.service || true
i=0
while mountpoint -q /pool; do
  i=$((i+1))
  [ $i -gt 60 ] && break
  umount /pool 2>/dev/null && break
  [ $i -eq 1 ] && log "umount busy - retrying every 5 s"
  sleep 5
done
if mountpoint -q /pool; then
  log "ABORT: /pool still mounted after 5 min. Holders:"
  "$HOLDERS" /pool
  exit 1
fi
log "/pool unmounted after $i attempt(s)"
systemctl reset-failed pool-mount.service 2>/dev/null || true

log "module refcount: $(awk '$1=="bcachefs"{print $3}' /proc/modules)"
rmmod bcachefs; log "rmmod ok"
modprobe bcachefs; log "loaded: $(cat /sys/module/bcachefs/version)"

log "starting pool-mount (PASSPHRASE PROMPT follows if the keyring lost the key)"
systemctl start pool-mount.service
mountpoint -q /pool || { log "ABORT: pool-mount did not mount /pool"; exit 1; }
log "/pool mounted"

systemctl start docker
for u in $STACKS $UNITS; do systemctl start "$u.service" || log "WARN: $u failed to start"; done
sleep 20
U=$(ls /sys/fs/bcachefs | grep -E '^[0-9a-f-]{36}$' | head -1)
log "module: $(cat /sys/module/bcachefs/version)"
for o in reconcile_wait_on_copygc promote_skip_congested foreground_target; do
  log "$o=$(cat "/sys/fs/bcachefs/$U/options/$o" 2>&1)"
done
log "containers: $(docker ps -q | wc -l)  haos-vm: $(systemctl is-active haos-vm.service)  pool-options: $(systemctl is-active bcachefs-pool-options.service)  governor: $(systemctl is-active nas-fg-governor.service)  raiser: $(systemctl is-active nas-replica-raiser.service)"
log "DONE"
