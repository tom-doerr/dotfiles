#!/usr/bin/env python3
"""Add a `forward` chain to spark-1's `table inet tailscale_only` and apply it. Run with sudo.

    sudo ~/git/dotfiles/scripts/spark1-forward-chain-patch            # patch /etc/nftables.conf, nft -c, nft -f
    sudo ~/git/dotfiles/scripts/spark1-forward-chain-patch --dry-run  # show the block, touch nothing

★ WHY (Sep 20 2026). `tailscale_only` filters only the INPUT hook. Docker publishes a container port
by DNAT in prerouting + FORWARD, so those packets NEVER reach input: measured from the robot on the
LAN, every host port was blocked but **5433 (a Postgres container) was OPEN**, and spark-1 publishes
five such ports on 0.0.0.0 (42905 idea-rank-web, 5433 ai_images postgres, 8910 flux2, 8090 ntfy,
7070 open-webui). Same structural hole the NAS had. This chain closes it at priority -100, before
Docker's own FORWARD chain, using the SAME transport model and the SAME `lan_peers` set as input.
Idempotent: refuses if a forward chain already exists. Backs up the file first.
"""
import re, subprocess, sys, shutil, time
CONF = '/etc/nftables.conf'
BLOCK = '''
    chain forward {
        type filter hook forward priority -100; policy accept;
        # [tom 2026-09-20] Docker-published ports are DNAT'd + FORWARDed and never touch `input`;
        # the robot reached container port 5433 on the LAN while every host port was blocked.
        ct state established,related accept
        iifname "lo" accept
        iifname "tailscale0" accept
        iifname "docker0" accept
        iifname "br-*" accept
        iifname "enp1s0f0np0" accept
        iifname "enP2p1s0f0np0" accept
        iifname "enp1s0f1np1" accept
        iifname "enP2p1s0f1np1" accept
        iifname "wg-nas" accept
        iifname "enP7s7" ip saddr @lan_peers accept
        ct state new iifname "enP7s7" counter drop   # [tom 2026-09-20] LAN -> DNAT'd container port
    }
'''
def main():
    dry = '--dry-run' in sys.argv
    text = open(CONF).read()
    if re.search(r'hook forward', text):
        sys.exit('REFUSING: %s already has a forward chain' % CONF)
    m = re.search(r'(table inet tailscale_only \{.*?)(\n\}\s*)$', text, re.S)
    if not m:
        sys.exit('REFUSING: could not find the closing brace of table inet tailscale_only')
    new = text[:m.end(1)] + BLOCK + text[m.end(1):]
    if dry:
        print(BLOCK); print('(dry run - nothing written)'); return
    bak = CONF + '.bak-%s-forward' % time.strftime('%Y%m%d-%H%M%S')
    shutil.copy2(CONF, bak); print('backup', bak)
    open(CONF, 'w').write(new)
    subprocess.run(['nft', '-c', '-f', CONF], check=True); print('syntax OK')
    subprocess.run(['nft', '-f', CONF], check=True); print('APPLIED')
    out = subprocess.run(['nft', 'list', 'chain', 'inet', 'tailscale_only', 'forward'], capture_output=True, text=True).stdout
    # (the first live run tripped here: `'%d' % a + b` binds as `('%d' % a) + b`, str + int - AFTER
    # the apply had already succeeded. Cosmetic, but a crash in a summary line reads as a failed deploy.)
    print('forward chain live: %d rules' % (out.count('accept')+out.count('drop')) if out
          else 'forward chain NOT found after apply')
if __name__ == '__main__': main()
