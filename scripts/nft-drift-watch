#!/usr/bin/env python3
"""Watch the live nftables ruleset for rules that are NOT in /etc/nftables.conf.

    nft-drift-watch [--once] [--interval 60]

★★★ WHY THIS EXISTS. Three times now a rule `iifname "enP7s7" accept` has appeared at the TOP of
spark-1's input chain at RUNTIME - not in the file, not in git, not in any unit or cron job, origin
never found - and it opens the ENTIRE wired LAN above the default-deny. Measured Sep 20 2026 from an
ordinary LAN device: ssh, Prometheus, Grafana, optuna and Postgres all reachable, with Prometheus
answering queries unauthenticated. A previous occurrence sat there for EIGHT DAYS and silently voided
the dry-run data that was supposed to justify enforcement. The rule is invisible precisely because
everything keeps working.

★★ THE POINT OF THE METRICS IS TO DISTINGUISH "NOTHING CHANGED" FROM "NOTHING WAS WATCHING."
`nft_drift_in_sync` is written on EVERY cycle, 1 or 0, and `nft_drift_last_check_timestamp_seconds`
with it. So a continuous run of 1s is positive evidence the watcher looked and found nothing, while a
GAP in the series means the watcher was not running - which a metric that only appears on divergence
could never tell you apart. Alert on staleness of the timestamp as well as on the value.

Reading the ruleset needs root, so this expects a narrow NOPASSWD entry (see nft-drift-watch.sudoers);
it only ever RUNS `nft list`, never a change.
"""
import argparse
import os
import re
import subprocess
import sys
import tempfile
import time

TABLE = 'inet tailscale_only'
CONFIG = '/etc/nftables.conf'
OUT = os.path.expanduser('~/.local/share/node_exporter/textfile/nft_drift.prom')
EVIDENCE = os.path.expanduser('~/.local/state/nft-drift-watch')

# Counters grow every packet and `nft -a` appends `# handle N`; neither is POLICY, and leaving them
# in would make every single cycle look like a change.
COUNTER = re.compile(r'\bcounter packets \d+ bytes \d+\b')
# ★ nft RE-SERIALISES what it loads, so the file's text and the listing's text differ for the SAME
# rule. Measured Sep 20 2026 against the real /etc/nftables.conf: the file's
# `meta nfproto ipv4 meta l4proto tcp ... limit rate 10/minute log` came back from the kernel as
# `... limit rate 10/minute burst 5 packets log` - the redundant meta dropped (implied by
# `ip saddr . tcp dport`), the default burst printed. Each of these is stripped from BOTH sides.
# Anything not on this list still shows as drift, which is the right failure direction: a false
# alarm gets a canonicalisation added here; a false silence would hide the next handle 19.
CANONICAL = (re.compile(r'\bburst \d+ packets\b'),
             re.compile(r'\bmeta nfproto ipv4\b'),
             re.compile(r'\bmeta l4proto tcp\b'))


def strip_comment(line):
    """`line` without its trailing `# ...`, honouring double quotes so `"a#b"` in a rule survives.

    ★ This has to happen BEFORE anything else looks at the line. The live listing writes
    `chain input { # handle 1`, so a naive `endswith('{')` never saw a block open and the parser
    collected NOTHING from the live side - which read as "every configured rule is missing".
    And /etc/nftables.conf tags every rule `# [who date] why`, which is policy documentation,
    not policy.
    """
    quoted = False
    for index, char in enumerate(line):
        if char == '"': quoted = not quoted
        elif char == '#' and not quoted: return line[:index]
    return line


def normalise(line):
    """One rule line reduced to its policy content: no comment, no counters, no stray whitespace."""
    line = COUNTER.sub('counter', strip_comment(line))
    for pattern in CANONICAL: line = pattern.sub('', line)
    return ' '.join(line.split()).strip().rstrip(';')


def joined_lines(text):
    """Physical lines with backslash continuations folded into one logical line each.

    The real config writes its longest rule over four lines ending in `\\`; read per physical line
    that was four "missing" fragments against one "extra" live rule, on a ruleset that was in fact
    in sync.
    """
    lines, pending = [], ''
    for raw in text.splitlines():
        body = strip_comment(raw).rstrip()
        if body.endswith('\\'):
            pending += body[:-1]+' '
            continue
        lines.append(pending+body)
        pending = ''
    if pending: lines.append(pending)
    return lines


def rules_of(text, table=TABLE):
    """{(chain, rule)} for every rule inside `table`, from an nft listing OR from nftables.conf.

    ★ Statements are split on ';' so that `type filter hook input priority -100; policy accept;`
    compares equal however the two sources chose to wrap it - formatting differences between the file
    and the live listing would otherwise show up as a permanent, trust-destroying false alarm.
    ★ `set`/`map` blocks are SKIPPED: the file declares their elements and the live listing shows
    whatever is in them now, so they legitimately differ and are not what this is looking for.
    """
    found, chain, depth, in_table, skip_depth = set(), None, 0, False, None
    for raw in joined_lines(text):
        stripped = strip_comment(raw).strip()
        if not stripped: continue
        opening = stripped.endswith('{')
        header = stripped[:-1].strip() if opening else stripped
        if opening:
            depth += 1
            if header.startswith('table ') and table in header: in_table = True
            elif in_table and skip_depth is None and header.split()[0] in ('set', 'map', 'element'):
                skip_depth = depth
            elif in_table and skip_depth is None and header.startswith('chain '):
                chain = header.split()[1]
            continue
        if stripped == '}':
            if skip_depth == depth: skip_depth = None
            elif chain is not None and in_table and skip_depth is None: chain = None
            elif in_table and depth == 1: in_table = False
            depth -= 1
            continue
        if not in_table or chain is None or skip_depth is not None: continue
        for part in stripped.split(';'):
            item = normalise(part)
            if item: found.add((chain, item))
    return found


def compare(live, configured):
    """(extra, missing): rules live-but-unconfigured, and configured-but-absent. Sorted, for logs."""
    return sorted(live-configured), sorted(configured-live)


def read_live(table=TABLE, run=subprocess.run):
    """The live ruleset via `sudo -n nft`. Raises with the command's own message if it cannot."""
    result = run(['sudo', '-n', 'nft', '-a', 'list', 'table']+table.split(),
                 capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError('cannot read the live ruleset: %s' % (result.stderr or '').strip())
    return result.stdout


def render(in_sync, extra, missing, now, error=None):
    """Prometheus text. EVERY cycle writes all of these, including the zeros - that is the design."""
    lines = [
        '# HELP nft_drift_in_sync 1 when the live ruleset matches %s, 0 when it does not.' % CONFIG,
        '# TYPE nft_drift_in_sync gauge',
        'nft_drift_in_sync %d' % (1 if in_sync else 0),
        '# HELP nft_drift_extra_rules Rules present in the live ruleset but not in the file.',
        '# TYPE nft_drift_extra_rules gauge',
        'nft_drift_extra_rules %d' % len(extra),
        '# HELP nft_drift_missing_rules Rules in the file that are absent from the live ruleset.',
        '# TYPE nft_drift_missing_rules gauge',
        'nft_drift_missing_rules %d' % len(missing),
        '# HELP nft_drift_up 1 when the ruleset could be read at all, 0 when the read failed.',
        '# TYPE nft_drift_up gauge',
        'nft_drift_up %d' % (0 if error else 1),
        '# HELP nft_drift_last_check_timestamp_seconds When the watcher last completed a check.',
        '# TYPE nft_drift_last_check_timestamp_seconds gauge',
        'nft_drift_last_check_timestamp_seconds %d' % int(now),
    ]
    return '\n'.join(lines)+'\n'


def publish(text, path=OUT):
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    handle, tmp = tempfile.mkstemp(dir=directory)
    with os.fdopen(handle, 'w') as out: out.write(text)
    os.chmod(tmp, 0o644)              # mkstemp is 0600; node_exporter has to read it
    os.replace(tmp, path)


def snapshot(extra, missing, live_text, directory=EVIDENCE, now=None, run=subprocess.run):
    """Write everything that might identify the culprit to a timestamped file; return its path.

    ★ THE SUSPECT LIST IS THE POINT. A drift that is only counted tells you it happened; the process
    table at the moment it is first seen tells you what was alive to do it. Each section records its
    own failure explicitly ("unreadable: ...") rather than being quietly empty, because an empty
    section reads as "nothing was running" - the one conclusion this must never manufacture.
    """
    now = time.time() if now is None else now
    os.makedirs(directory, exist_ok=True)
    stamp = time.strftime('%Y%m%d-%H%M%S', time.localtime(now))
    path = os.path.join(directory, 'drift-%s.txt' % stamp)

    def section(title, argv):
        try:
            result = run(argv, capture_output=True, text=True, timeout=20)
            body = result.stdout if result.returncode == 0 else 'unreadable: rc %d %s' % (
                result.returncode, (result.stderr or '').strip())
        except Exception as failure:
            body = 'unreadable: %s' % failure
        return '\n=== %s (%s)\n%s' % (title, ' '.join(argv), body)

    parts = ['nft drift detected at %s' % time.strftime('%Y-%m-%d %H:%M:%S %Z', time.localtime(now)),
             '\n=== EXTRA (live, not in %s)\n%s' % (CONFIG, '\n'.join('%s: %s' % r for r in extra) or '(none)'),
             '\n=== MISSING (in file, not live)\n%s' % ('\n'.join('%s: %s' % r for r in missing) or '(none)'),
             '\n=== live listing with handles\n%s' % live_text,
             section('processes, oldest first', ['ps', '-eo', 'pid,ppid,user,lstart,etimes,args', '--sort=lstart']),
             section('logins', ['who', '-a']),
             section('journal, last 15 minutes (capped)', ['journalctl', '--since', '-15min', '-n', '600', '--no-pager', '-o', 'short-iso']),
             section('nft-related units', ['systemctl', 'list-units', '--all', '--no-pager', '*nft*', '*firewall*', '*tailscale*'])]
    with open(path, 'w') as out: out.write('\n'.join(parts)+'\n')
    return path


def check(read_live_text=read_live, read_config=lambda: open(CONFIG).read()):
    """One comparison. Returns (in_sync, extra, missing, live_text, error)."""
    try:
        live_text = read_live_text()
    except Exception as failure:
        return False, [], [], '', str(failure)
    extra, missing = compare(rules_of(live_text), rules_of(read_config()))
    return not extra and not missing, extra, missing, live_text, None


def log(message):
    print(time.strftime('%H:%M:%S')+' '+message, flush=True)


def loop(interval=60., once=False, heartbeat_every=60, checker=check, publisher=publish,
         snapshotter=snapshot, sleep=time.sleep, now=time.time):
    """Check forever (or once), publishing EVERY cycle and logging every state change.

    Logging policy, chosen so the journal can answer "was it watching?" as well as "did it drift?":
    the first result is always logged; every CHANGE is logged; and while in sync a heartbeat line is
    logged every `heartbeat_every` cycles. While diverged, evidence is snapshotted on the transition
    and then once per heartbeat period, not every minute - the first snapshot has the suspects.
    """
    previous, cycles = None, 0
    while True:
        in_sync, extra, missing, live_text, error = checker()
        moment = now()
        publisher(render(in_sync, extra, missing, moment, error=error))
        changed = in_sync != previous
        periodic = cycles % heartbeat_every == 0
        if error:
            if changed or periodic: log('CANNOT READ RULESET - %s (published nft_drift_up 0)' % error)
        elif in_sync:
            if changed or periodic: log('in sync with %s' % CONFIG)
        else:
            if changed or periodic:
                where = snapshotter(extra, missing, live_text, now=moment)
                log('DRIFT: %d extra, %d missing rule(s); evidence in %s' % (len(extra), len(missing), where))
                for chain, rule in extra: log('  extra   [%s] %s' % (chain, rule))
                for chain, rule in missing: log('  missing [%s] %s' % (chain, rule))
        previous, cycles = in_sync, cycles+1
        if once: return in_sync
        sleep(interval)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--interval', type=float, default=float(os.environ.get('NFT_DRIFT_INTERVAL', 60)))
    parser.add_argument('--once', action='store_true', help='one check, exit 0 if in sync else 1')
    args = parser.parse_args()
    in_sync = loop(interval=args.interval, once=args.once)
    if args.once: sys.exit(0 if in_sync else 1)


if __name__ == '__main__': main()
