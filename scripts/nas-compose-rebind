#!/usr/bin/env python3
"""Rebind every published compose port on the NAS from 0.0.0.0 to 127.0.0.1 + the Tailscale IP.

    nas-compose-rebind            report what would change (no writes)
    nas-compose-rebind --apply    rewrite (with .bak-<stamp>), then restart the affected stacks

★ WHY TWO BINDINGS PER PORT. 127.0.0.1 keeps every loopback consumer alive — the HA VM reaches its
recorder at 10.0.2.2:5434 through slirp, which lands on the host as loopback, and the NAS's own
`curl localhost:9090/-/reload`. 100.85.146.21 keeps the sparks, which all address the NAS over
Tailscale now. Nothing binds the LAN address, so even with no firewall Docker never opens 0.0.0.0.
★ REFUSES rather than silently doing nothing: a compose file with zero rewritable port lines, or a
`ports:` entry it cannot parse, aborts the whole run before any file is touched.
"""
import argparse, os, re, shutil, subprocess, sys, time

TAILSCALE = '100.85.146.21'
FILES = ['/pool/services/%s' % f for f in (
    'cadvisor/compose.yml', 'homeassistant/postgres/docker-compose.yml', 'immich/docker-compose.yml',
    'mlflow/compose.yml', 'minio/compose.yml', 'postgres/compose.yml', 'phoenix/compose.yml',
    'prometheus/compose.yml')]
# `- "9000:9000"`, `- 5434:5432`, `- "0.0.0.0:5434:5432"`, `- ${IMMICH_PORT:-2283}:2283`, `- "4317:4317/tcp"`
# A bind prefix of `0.0.0.0:` or a variable defaulting to it (`${MLFLOW_BIND:-0.0.0.0}:`) is REPLACED —
# a variable whose whole purpose was "which address to bind" is exactly what is being decided here.
PORT = re.compile(r'^(?P<indent>\s*-\s*)(?P<q>["\']?)(?:0\.0\.0\.0:|\$\{[A-Za-z_]+:-0\.0\.0\.0\}:)?(?P<host>\d+|\$\{[^}]+\}):(?P<cont>\d+(?:/(?:tcp|udp))?)(?P=q)\s*(?P<comment>#.*)?$')
ANY_PORTISH = re.compile(r'^\s*-\s*["\']?[\w${}:.-]*:\d+')
GRACEFUL = ('nas-postgres', 'ha_postgres_recorder')       # published-port Postgres: stop -t 600 first


def rewrite(text):
    """(new_text, changed_lines). Only lines inside a `ports:` block are considered."""
    out, changed, in_ports, ports_indent = [], 0, False, 0
    for line in text.splitlines():
        stripped = line.lstrip()
        indent = len(line)-len(stripped)
        if stripped.startswith('ports:'):
            in_ports, ports_indent = True, indent; out.append(line); continue
        if in_ports and stripped and not stripped.startswith('-') and indent <= ports_indent:
            in_ports = False
        if in_ports and stripped.startswith('-'):
            m = PORT.match(line)
            if m:
                pre, q, host, cont = m['indent'], m['q'], m['host'], m['cont']
                if '${' in host or '${' in cont: q = '"' if not q else q   # variables must be quoted
                tail = ('   '+m['comment']) if m['comment'] else ''
                out.append('%s%s127.0.0.1:%s:%s%s%s' % (pre, q, host, cont, q, tail))
                out.append('%s%s%s:%s:%s%s' % (pre, q, TAILSCALE, host, cont, q))
                changed += 1; continue
            if ('127.0.0.1:' in line or TAILSCALE+':' in line):
                out.append(line); continue                 # already rebound: idempotent
            if ANY_PORTISH.match(line):
                raise ValueError('cannot parse ports entry: %r' % line)
        out.append(line)
    return '\n'.join(out)+'\n', changed


def main():
    ap = argparse.ArgumentParser(); ap.add_argument('--apply', action='store_true'); a = ap.parse_args()
    plans = []
    for path in FILES:
        text = open(path).read()
        new, changed = rewrite(text)
        if changed == 0 and TAILSCALE not in text:
            sys.exit('REFUSING: %s has no rewritable port line and no existing rebinding' % path)
        plans.append((path, new, changed))
        print('%-58s %d port line(s) -> rebound' % (path, changed))
    if not a.apply:
        print('dry run; re-run with --apply'); return
    stamp = time.strftime('%Y%m%d-%H%M%S')
    for path, new, changed in plans:
        if changed == 0: continue
        shutil.copy2(path, path+'.bak-'+stamp+'-lan')
        with open(path, 'w') as f: f.write(new)
    print('files written; backups *.bak-%s-lan' % stamp)
    subprocess.run(['docker', 'stop', '-t', '600', *GRACEFUL], check=False)
    for path, _, changed in plans:
        if changed == 0: continue
        cmd = ['/usr/local/sbin/immich-compose', 'up', '-d'] if '/immich/' in path else \
              ['docker', 'compose', '-f', path, 'up', '-d']
        print('==', ' '.join(cmd)); subprocess.run(cmd, check=True)
    print('REBIND_DONE')


if __name__ == '__main__': main()
