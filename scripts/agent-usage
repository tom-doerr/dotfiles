#!/usr/bin/env python3
"""Subscription quota bars for Claude Code and Codex — what /usage shows, in the bar.

Claude: GET https://api.anthropic.com/api/oauth/usage with the OAuth token Claude
Code already stores in ~/.claude/.credentials.json.  That is the SAME source the
/usage dialog draws its bars from (server-side truth), not a local estimate — its
"limits" array carries session (5h), weekly-all and weekly-scoped (Fable) percents.

Codex: GET https://chatgpt.com/backend-api/wham/usage with the ChatGPT token Codex
stores in ~/.codex/auth.json, the endpoint the Codex client reads its own limits
from.  (The `rate_limits` logged in the rollout files, used before, are only as
fresh as the last Codex request: after a quiet week they described a window that
had already reset, and a new rollout without a request yet had none at all.)

--waybar prints a waybar JSON object; default prints the parsed numbers.
--row time draws the SAME bars filled by how far the window has elapsed, so a second
waybar row sits directly under the first: usage bar longer than time bar = burning the
quota faster than the clock.  Both rows share one cached fetch per source (STATE_DIR).
A source that cannot be read shows as a red "no data" segment in its place: never as
old numbers, and never by silently dropping out of the row.
"""

from __future__ import annotations

import argparse
import html
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
CREDENTIALS = HOME / ".claude" / ".credentials.json"
CODEX_AUTH = HOME / ".codex" / "auth.json"
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
CODEX_USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"
STATE_DIR = HOME / ".local" / "state" / "agent-usage"
CACHE_FRESH = 240  # the endpoints rate-limit frequent polling; rows share one fetch
SESSION_WINDOW = 5 * 3600
WEEK_WINDOW = 7 * 86400

FILL, EMPTY = "█", "░"
COL_DIM, COL_WARN, COL_CRIT, COL_OK = "#6272a4", "#f1fa8c", "#ff5555", "#50fa7b"


# --------------------------------------------------------------------------- sources


def fetch_json(url: str, headers: dict[str, str], timeout: int = 15) -> dict:
    """GET `url`. The headers carry bearer tokens, so curl reads them from stdin
    (`-H @-`), never from its command line, where `ps` would show them."""
    out = subprocess.run(
        ["curl", "-sS", "-m", str(timeout), "-H", "@-", url],
        input="".join(f"{k}: {v}\n" for k, v in headers.items()),
        capture_output=True, text=True, timeout=timeout + 5,
    )
    if out.returncode != 0:
        raise RuntimeError(f"curl exit {out.returncode}: {out.stderr.strip()[:200]}")
    return json.loads(out.stdout)


def claude_usage(timeout: int = 15) -> dict:
    """Raw /api/oauth/usage payload. Raises on any failure — callers show that."""
    creds = json.loads(CREDENTIALS.read_text())["claudeAiOauth"]
    payload = fetch_json(USAGE_URL, {"Authorization": f"Bearer {creds['accessToken']}",
                                     "anthropic-beta": "oauth-2025-04-20"}, timeout)
    # The endpoint answers HTTP 200 with an {"error": ...} body when it rate-limits
    # (it does, if polled every couple of minutes). Without this check that body
    # caches as a valid payload and every bar silently disappears.
    if "limits" not in payload:
        raise RuntimeError(f"unexpected payload: {json.dumps(payload)[:200]}")
    return payload


def claude_entries(payload: dict) -> list[dict]:
    """The three bars /usage draws, in its order: session, weekly all, weekly scoped."""
    names = {"session": "CC 5h", "weekly_all": "7d"}
    windows = {"session": SESSION_WINDOW, "weekly_all": WEEK_WINDOW, "weekly_scoped": WEEK_WINDOW}
    entries = []
    for lim in payload.get("limits") or []:
        kind = lim.get("kind")
        label = names.get(kind)
        if label is None and kind == "weekly_scoped":
            label = ((lim.get("scope") or {}).get("model") or {}).get("display_name") or "scoped"
        if label is None:
            continue  # an unknown limit kind is skipped, not guessed at
        entries.append({
            "label": label,
            "percent": lim.get("percent", 0),
            "severity": lim.get("severity", "normal"),
            "resets_at": lim.get("resets_at"),
            "window_seconds": windows.get(kind),
        })
    return entries


def codex_usage(timeout: int = 15) -> dict:
    """The `rate_limit` object of /wham/usage (the rest of the payload names the
    account, so it is not cached). Raises on any failure — callers show that."""
    tokens = json.loads(CODEX_AUTH.read_text())["tokens"]
    payload = fetch_json(CODEX_USAGE_URL, {"Authorization": f"Bearer {tokens['access_token']}",
                                           "ChatGPT-Account-Id": tokens["account_id"]}, timeout)
    # An expired token or a refused request is a JSON body too: without this check
    # it would cache as a valid payload with no bars in it.
    if not isinstance(payload.get("rate_limit"), dict):
        raise RuntimeError(f"unexpected payload: {json.dumps(payload)[:200]}")
    return payload["rate_limit"]


def codex_entries(limits: dict) -> list[dict]:
    """One bar per window the plan has: `primary_window`, then `secondary_window`
    (Pro has only a weekly primary; a null window is not drawn)."""
    entries = []
    for key in ("primary_window", "secondary_window"):
        win = limits.get(key)
        if not win:
            continue
        seconds = win.get("limit_window_seconds") or 0
        hours = round(seconds / 3600)
        entries.append({
            "label": f"CDX {hours // 24}d" if hours >= 24 else f"CDX {hours}h",
            "percent": round(win.get("used_percent", 0)),
            "severity": "critical" if limits.get("limit_reached") else "normal",
            "resets_at": win.get("reset_at"),
            "window_seconds": seconds or None,
        })
    return entries


# --------------------------------------------------------------------------- pace


def reset_epoch(entry: dict) -> float | None:
    val = entry.get("resets_at")
    if val is None:
        return None
    if isinstance(val, (int, float)):
        return float(val)
    return datetime.fromisoformat(str(val).replace("Z", "+00:00")).timestamp()


def elapsed_percent(entry: dict, now: float | None = None) -> int | None:
    """How far through its window this limit is. None when the window is unknown."""
    window, ends = entry.get("window_seconds"), reset_epoch(entry)
    if not window or ends is None:
        return None
    now = time.time() if now is None else now
    return round(max(0.0, min(1.0, (window - (ends - now)) / window)) * 100)


def pace_colour(entry: dict, elapsed: int) -> str | None:
    """Colour the TIME bar by what the current burn rate projects to at reset.

    Early in a window the ratio is meaningless (1% elapsed, 3% used = "300%"),
    so below 5% elapsed it stays neutral rather than crying wolf.
    """
    if elapsed < 5:
        return None
    projected = entry["percent"] / elapsed * 100
    if projected > 150:
        return COL_CRIT
    if projected > 100:
        return COL_WARN
    return COL_OK


# --------------------------------------------------------------------------- render


def colour(entry: dict) -> str | None:
    """Colour means "close to the limit", not "in use" — at 50% a yellow bar all
    week is noise. The server's own severity still wins when it escalates."""
    if entry["percent"] >= 90 or entry["severity"] == "critical":
        return COL_CRIT
    if entry["percent"] >= 70 or entry["severity"] == "warning":
        return COL_WARN
    return None


def filled_cells(percent: int, width: int = 10) -> int:
    # Any nonzero usage lights at least one cell: a 3% bar that renders empty
    # is indistinguishable from "no data".
    n = max(0, min(width, round(percent * width / 100)))
    return 1 if n == 0 and percent > 0 else n


def bar(percent: int, width: int = 10) -> str:
    n = filled_cells(percent, width)
    return FILL * n + EMPTY * (width - n)


def segment(entry: dict, width: int = 10) -> str:
    if entry["percent"] is None:
        return no_data_segment(entry, width)
    n = filled_cells(entry["percent"], width)
    col = colour(entry)
    fill = f"<span color='{col}'>{FILL * n}</span>" if col else FILL * n
    # The unfilled part stays dim so the filled part alone reads as the value.
    body = fill + f"<span color='{COL_DIM}'>{EMPTY * (width - n)}</span>"
    return f"{entry['label']} {body}{entry['percent']:>3}%"


def short_age(seconds: float) -> str:
    minutes = seconds / 60
    if minutes < 60:
        return f"{minutes:.0f}m"
    return f"{minutes / 60:.0f}h" if minutes < 48 * 60 else f"{minutes / 1440:.0f}d"


def no_data_segment(entry: dict, width: int = 10) -> str:
    """A source that could not be read: red, saying how long it has been silent,
    and exactly as wide as a bar segment, so the two rows still line up."""
    age = entry.get("last_ok_age")
    note = "no data" + (f" {short_age(age)}" if age is not None else "")
    return f"{entry['label']} <span color='{COL_CRIT}'>{note[:width + 4]:<{width + 4}}</span>"


def time_segment(entry: dict, width: int = 10) -> str:
    """Same geometry as segment(), filled by elapsed time — it must line up column
    for column under the usage row, so the label text is repeated (dimmed), never
    shortened."""
    if entry["percent"] is None:
        return no_data_segment(entry, width)
    elapsed = elapsed_percent(entry)
    label = f"<span color='{COL_DIM}'>{entry['label']}</span>"
    if elapsed is None:
        return f"{label} <span color='{COL_DIM}'>{'?' * width}   ?</span>"
    n = filled_cells(elapsed, width)
    col = pace_colour(entry, elapsed) or COL_DIM
    body = f"<span color='{col}'>{FILL * n}</span><span color='{COL_DIM}'>{EMPTY * (width - n)}</span>"
    return f"{label} {body}<span color='{COL_DIM}'>{elapsed:>3}%</span>"


def reset_note(entry: dict) -> str:
    val = entry.get("resets_at")
    if val is None:
        return "no reset time"
    when = (
        datetime.fromtimestamp(val, timezone.utc)
        if isinstance(val, (int, float))
        else datetime.fromisoformat(str(val).replace("Z", "+00:00"))
    )
    hours = (when - datetime.now(timezone.utc)).total_seconds() / 3600
    return f"resets in {hours:.0f}h ({when.astimezone().strftime('%a %H:%M')})"


def cached_payload(name: str, fetch, max_age: float = CACHE_FRESH) -> dict:
    """Source `name`'s payload, fetched at most every `max_age` seconds: two waybar
    rows poll this, and within CACHE_FRESH they share one fetch. A failed fetch
    raises; an older payload is never shown in its place."""
    state = STATE_DIR / f"{name}.json"
    try:
        cached = json.loads(state.read_text())
        if time.time() - cached["fetched_at"] <= max_age:
            return cached["payload"]
    except (OSError, ValueError, KeyError):
        pass  # no usable cache: fetch
    payload = fetch()
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = state.with_suffix(f".tmp{os.getpid()}")
    tmp.write_text(json.dumps({"fetched_at": time.time(), "payload": payload}))
    tmp.replace(state)
    return payload


def last_ok_age(name: str) -> float | None:
    """Seconds since source `name` was last fetched successfully (None = never)."""
    try:
        return time.time() - json.loads((STATE_DIR / f"{name}.json").read_text())["fetched_at"]
    except (OSError, ValueError, KeyError):
        return None


# (placeholder label, state file name, fetch, parse), in row order
SOURCES = (
    ("CC", "claude", claude_usage, claude_entries),
    ("CDX", "codex", codex_usage, codex_entries),
)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--waybar", action="store_true", help="emit waybar JSON")
    ap.add_argument("--row", choices=("usage", "time"), default="usage", help="which of the two rows to draw")
    ap.add_argument("--width", type=int, default=10, help="bar width in characters")
    ap.add_argument("--max-age", type=float, default=CACHE_FRESH, dest="max_age",
                    help="accept a cached payload this old before refetching (seconds); "
                         "callers that only need window START times can pass a large value")
    args = ap.parse_args()

    entries, problems = [], []
    for label, name, fetch, parse in SOURCES:
        try:
            payload = cached_payload(name, fetch, args.max_age)
            got = parse(payload)
            if not got:
                raise RuntimeError(f"no usable limits in the payload ({sorted(payload)[:6]})")
        except Exception as err:  # network, token, JSON shape: shown in the row, never dropped
            problems.append(f"{name}: {type(err).__name__}: {err}")
            got = [{"label": label, "percent": None, "last_ok_age": last_ok_age(name)}]
        entries.extend(got)

    if not args.waybar:
        for e in entries:
            e["elapsed_percent"] = elapsed_percent(e)
        print(json.dumps({"entries": entries, "problems": problems}, indent=2))
        return 1 if problems else 0

    draw = time_segment if args.row == "time" else segment
    text = "  ".join(draw(e, args.width) for e in entries)
    tip = []
    for e in entries:
        if e["percent"] is None:
            age = e["last_ok_age"]
            last = "never fetched" if age is None else f"last good fetch {age / 60:.0f} min ago"
            tip.append(f"{e['label']}: NO DATA ({last})")
            continue
        elapsed = elapsed_percent(e)
        line = f"{e['label']}: {e['percent']}% used, {reset_note(e)}"
        if elapsed is not None:
            pace = f", {e['percent'] / elapsed * 100:.0f}% of quota projected at reset" if elapsed >= 5 else ""
            line += f"\n    {elapsed}% of the window elapsed{pace}"
        tip.append(line)
    tip.append("\nTop row = quota used, bottom row = window elapsed; bottom bar longer means")
    tip.append("you are under pace. Bottom-bar colour is the projection: green on track,")
    tip.append("yellow >100%, red >150% of quota by reset.")
    tip.append("Claude: live from /api/oauth/usage (same source as /usage).")
    tip.append("Codex: live from chatgpt.com/backend-api/wham/usage (the Codex client's own source).")
    tip += [html.escape(p, quote=False) for p in problems]  # error bodies can hold markup
    print(json.dumps({"text": text, "tooltip": "\n".join(tip)}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
