#!/usr/bin/env python3
"""Subscription quota bars for Claude Code and Codex — what /usage shows, in the bar.

Claude: GET https://api.anthropic.com/api/oauth/usage with the OAuth token Claude
Code already stores in ~/.claude/.credentials.json.  That is the SAME source the
/usage dialog draws its bars from (server-side truth), not a local estimate — its
"limits" array carries session (5h), weekly-all and weekly-scoped (Fable) percents.

Codex: the last `rate_limits` block logged in the newest ~/.codex/sessions rollout.
Codex writes it on every token_count event, so it is exact as of the last request
and only ever an OVER-estimate afterwards (the window rolls forward while nothing
is being logged).  Its age is reported rather than hidden.

--waybar prints a waybar JSON object; default prints the parsed numbers.
--row time draws the SAME bars filled by how far the window has elapsed, so a second
waybar row sits directly under the first: usage bar longer than time bar = burning the
quota faster than the clock.  Both rows share one cached fetch (see STATE).
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
CREDENTIALS = HOME / ".claude" / ".credentials.json"
CODEX_DIR = HOME / ".codex" / "sessions"
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
STALE_SECONDS = 6 * 3600  # a Codex snapshot older than this is dimmed as stale
STATE = HOME / ".local" / "state" / "agent-usage" / "payload.json"
CACHE_FRESH = 90   # both rows run every 120s; within this they share one fetch
CACHE_MAX = 900    # older than this, a failed fetch is an error, not a stale bar
SESSION_WINDOW = 5 * 3600
WEEK_WINDOW = 7 * 86400

FILL, EMPTY = "█", "░"
COL_DIM, COL_WARN, COL_CRIT, COL_OK = "#6272a4", "#f1fa8c", "#ff5555", "#50fa7b"


# --------------------------------------------------------------------------- sources


def claude_usage(timeout: int = 15) -> dict:
    """Raw /api/oauth/usage payload. Raises on any failure — callers show that."""
    creds = json.loads(CREDENTIALS.read_text())["claudeAiOauth"]
    out = subprocess.run(
        ["curl", "-sS", "-m", str(timeout), "-H", f"Authorization: Bearer {creds['accessToken']}",
         "-H", "anthropic-beta: oauth-2025-04-20", USAGE_URL],
        capture_output=True, text=True, timeout=timeout + 5,
    )
    if out.returncode != 0:
        raise RuntimeError(f"curl exit {out.returncode}: {out.stderr.strip()[:200]}")
    return json.loads(out.stdout)


def claude_entries(payload: dict) -> list[dict]:
    """The three bars /usage draws, in its order: session, weekly all, weekly scoped."""
    names = {"session": "CC 5h", "weekly_all": "7d"}
    windows = {"session": SESSION_WINDOW, "weekly_all": WEEK_WINDOW, "weekly_scoped": WEEK_WINDOW}
    entries = []
    for lim in payload.get("limits") or []:
        kind = lim.get("kind")
        label = names.get(kind)
        if label is None and kind == "weekly_scoped":
            label = ((lim.get("scope") or {}).get("model") or {}).get("display_name") or "scoped"
        if label is None:
            continue  # an unknown limit kind is skipped, not guessed at
        entries.append({
            "label": label,
            "percent": lim.get("percent", 0),
            "severity": lim.get("severity", "normal"),
            "resets_at": lim.get("resets_at"),
            "window_seconds": windows.get(kind),
            "stale_seconds": 0,
        })
    return entries


def newest_codex_session() -> Path | None:
    files = list(CODEX_DIR.glob("**/*.jsonl")) if CODEX_DIR.exists() else []
    return max(files, key=lambda f: f.stat().st_mtime) if files else None


def codex_entry(path: Path, tail_bytes: int = 4_000_000) -> dict | None:
    """Last rate_limits block in a rollout file (tail only — these files reach 100s of MB)."""
    size = path.stat().st_size
    with path.open("rb") as fh:
        if size > tail_bytes:
            fh.seek(size - tail_bytes)
            fh.readline()  # discard the partial line
        last = None
        for raw in fh:
            if b'"rate_limits"' not in raw:
                continue
            try:
                rec = json.loads(raw)
            except ValueError:
                continue
            limits = (rec.get("payload") or {}).get("rate_limits")
            if limits and limits.get("primary"):
                last = (rec.get("timestamp"), limits["primary"])
    if not last:
        return None
    stamp, primary = last
    age = 0
    if stamp:
        age = max(0, int(time.time() - datetime.fromisoformat(stamp.replace("Z", "+00:00")).timestamp()))
    window_h = round((primary.get("window_minutes") or 0) / 60)
    return {
        "label": f"CDX {window_h // 24}d" if window_h >= 24 else f"CDX {window_h}h",
        "percent": round(primary.get("used_percent", 0)),
        "severity": "normal",
        "resets_at": primary.get("resets_at"),
        "window_seconds": (primary.get("window_minutes") or 0) * 60 or None,
        "stale_seconds": age,
    }


# --------------------------------------------------------------------------- pace


def reset_epoch(entry: dict) -> float | None:
    val = entry.get("resets_at")
    if val is None:
        return None
    if isinstance(val, (int, float)):
        return float(val)
    return datetime.fromisoformat(str(val).replace("Z", "+00:00")).timestamp()


def elapsed_percent(entry: dict, now: float | None = None) -> int | None:
    """How far through its window this limit is. None when the window is unknown."""
    window, ends = entry.get("window_seconds"), reset_epoch(entry)
    if not window or ends is None:
        return None
    now = time.time() if now is None else now
    return round(max(0.0, min(1.0, (window - (ends - now)) / window)) * 100)


def pace_colour(entry: dict, elapsed: int) -> str | None:
    """Colour the TIME bar by what the current burn rate projects to at reset.

    Early in a window the ratio is meaningless (1% elapsed, 3% used = "300%"),
    so below 5% elapsed it stays neutral rather than crying wolf.
    """
    if elapsed < 5:
        return None
    projected = entry["percent"] / elapsed * 100
    if projected > 150:
        return COL_CRIT
    if projected > 100:
        return COL_WARN
    return COL_OK


# --------------------------------------------------------------------------- render


def colour(entry: dict) -> str | None:
    """Colour means "close to the limit", not "in use" — at 50% a yellow bar all
    week is noise. The server's own severity still wins when it escalates."""
    if entry["percent"] >= 90 or entry["severity"] == "critical":
        return COL_CRIT
    if entry["percent"] >= 70 or entry["severity"] == "warning":
        return COL_WARN
    return None


def filled_cells(percent: int, width: int = 10) -> int:
    # Any nonzero usage lights at least one cell: a 3% bar that renders empty
    # is indistinguishable from "no data".
    n = max(0, min(width, round(percent * width / 100)))
    return 1 if n == 0 and percent > 0 else n


def bar(percent: int, width: int = 10) -> str:
    n = filled_cells(percent, width)
    return FILL * n + EMPTY * (width - n)


def segment(entry: dict, width: int = 10) -> str:
    n = filled_cells(entry["percent"], width)
    col = colour(entry)
    fill = f"<span color='{col}'>{FILL * n}</span>" if col else FILL * n
    # The unfilled part stays dim so the filled part alone reads as the value.
    body = fill + f"<span color='{COL_DIM}'>{EMPTY * (width - n)}</span>"
    text = f"{entry['label']} {body}{entry['percent']:>3}%"
    if entry["stale_seconds"] > STALE_SECONDS:
        text = f"<span color='{COL_DIM}'>{text}</span>"
    return text


def time_segment(entry: dict, width: int = 10) -> str:
    """Same geometry as segment(), filled by elapsed time — it must line up column
    for column under the usage row, so the label text is repeated (dimmed), never
    shortened."""
    elapsed = elapsed_percent(entry)
    label = f"<span color='{COL_DIM}'>{entry['label']}</span>"
    if elapsed is None:
        return f"{label} <span color='{COL_DIM}'>{'?' * width}   ?</span>"
    n = filled_cells(elapsed, width)
    col = pace_colour(entry, elapsed) or COL_DIM
    body = f"<span color='{col}'>{FILL * n}</span><span color='{COL_DIM}'>{EMPTY * (width - n)}</span>"
    return f"{label} {body}<span color='{COL_DIM}'>{elapsed:>3}%</span>"


def reset_note(entry: dict) -> str:
    val = entry.get("resets_at")
    if val is None:
        return "no reset time"
    when = (
        datetime.fromtimestamp(val, timezone.utc)
        if isinstance(val, (int, float))
        else datetime.fromisoformat(str(val).replace("Z", "+00:00"))
    )
    hours = (when - datetime.now(timezone.utc)).total_seconds() / 3600
    return f"resets in {hours:.0f}h ({when.astimezone().strftime('%a %H:%M')})"


def cached_claude_usage() -> tuple[dict, float]:
    """(payload, age_seconds). Two waybar rows poll this; within CACHE_FRESH they
    share one fetch. A failed fetch may fall back to a cache younger than CACHE_MAX,
    and the age is then reported — it is never passed off as live."""
    cached = None
    try:
        cached = json.loads(STATE.read_text())
        age = time.time() - cached["fetched_at"]
        if age <= CACHE_FRESH:
            return cached["payload"], age
    except (OSError, ValueError, KeyError):
        cached = None
    try:
        payload = claude_usage()
    except Exception:
        if cached:
            age = time.time() - cached["fetched_at"]
            if age <= CACHE_MAX:
                return cached["payload"], age
        raise
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(f".tmp{os.getpid()}")
    tmp.write_text(json.dumps({"fetched_at": time.time(), "payload": payload}))
    tmp.replace(STATE)
    return payload, 0.0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--waybar", action="store_true", help="emit waybar JSON")
    ap.add_argument("--row", choices=("usage", "time"), default="usage", help="which of the two rows to draw")
    ap.add_argument("--width", type=int, default=10, help="bar width in characters")
    args = ap.parse_args()

    entries, problems = [], []
    try:
        payload, age = cached_claude_usage()
        entries.extend(claude_entries(payload))
        if age > CACHE_FRESH:
            problems.append(f"claude usage: fetch failed, showing cache {age / 60:.0f} min old")
    except Exception as err:  # network, token, JSON shape: all shown, never silently zeroed
        problems.append(f"claude usage: {type(err).__name__}: {err}")
    try:
        path = newest_codex_session()
        entry = codex_entry(path) if path else None
        if entry:
            entries.append(entry)
        else:
            problems.append("codex: no rate_limits in the newest rollout")
    except Exception as err:
        problems.append(f"codex: {type(err).__name__}: {err}")

    if not args.waybar:
        for e in entries:
            e["elapsed_percent"] = elapsed_percent(e)
        print(json.dumps({"entries": entries, "problems": problems}, indent=2))
        return 1 if problems else 0

    draw = time_segment if args.row == "time" else segment
    text = "  ".join(draw(e, args.width) for e in entries)
    if problems:
        text = (text + "  " if text else "") + f"<span color='{COL_CRIT}'>usage ?</span>"
    tip = []
    for e in entries:
        elapsed = elapsed_percent(e)
        line = f"{e['label']}: {e['percent']}% used, {reset_note(e)}"
        if elapsed is not None:
            pace = f", {e['percent'] / elapsed * 100:.0f}% of quota projected at reset" if elapsed >= 5 else ""
            line += f"\n    {elapsed}% of the window elapsed{pace}"
        if e["stale_seconds"] > STALE_SECONDS:
            line += f"  [snapshot {e['stale_seconds'] // 3600}h old]"
        tip.append(line)
    tip.append("\nTop row = quota used, bottom row = window elapsed; bottom bar longer means")
    tip.append("you are under pace. Bottom-bar colour is the projection: green on track,")
    tip.append("yellow >100%, red >150% of quota by reset.")
    tip.append("Claude: live from /api/oauth/usage (same source as /usage).")
    tip.append("Codex: last rate_limits logged in the newest rollout; only ever an over-estimate.")
    print(json.dumps({"text": text, "tooltip": "\n".join(tip + problems)}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
